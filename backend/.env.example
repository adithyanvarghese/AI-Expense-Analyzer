# Environment Configuration Example
SECRET_KEY=django-insecure-change-this-in-production-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,your-backend-app.onrender.com

# PostgreSQL Database URL (Render / Supabase / Neon / Local PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/NAME
# Leave empty to default to local SQLite during development
DATABASE_URL=postgresql://user:password@localhost:5432/expense_db

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
